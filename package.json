{
  "name": "polyweather-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "compare:weather-settlement": "node --import tsx ./scripts/compare-weather-settlement.ts",
    "compare:backfill-history": "node --import tsx ./scripts/backfill-comparison-history.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@types/compression": "^1.8.1",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.9.4",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9",
    "globals": "^16.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.7"
  }
}
